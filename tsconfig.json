{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib",
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "declaration": true,
        "strict": true,
        "noImplicitAny": true,
        "jsx": "react-jsx"
    },
    "include": ["src"],
    "exclude": ["node_modules"]
}
